{
  "datasets": [
    {
      "name": "offensive_rankings",
      "displayName": "Offensive Rankings",
      "queryLines": [
        "WITH offensive_stats AS (\n",
        "  SELECT \n",
        "    s.season,\n",
        "    s.team_name,\n",
        "    t.primary_logo_url as team_logo,\n",
        "    t.conference_name,\n",
        "    s.games as G,\n",
        "    (s.rushing_attempts + s.pass_attempts) as PLAYS,\n",
        "    s.total_yards as YDS,\n",
        "    ROUND(s.yards_per_play, 2) as YDS_PLAY,\n",
        "    (s.passing_tds + s.rushing_tds) as OFF_TDS,\n",
        "    ROUND(s.yards_per_game, 1) as YPG\n",
        "  FROM cfdb_dev.silver_clean.season_stats s\n",
        "  JOIN cfdb_dev.silver_clean.teams t ON s.team_id = t.team_id\n",
        "  WHERE s.games > 0\n",
        "),\n",
        "ranked_offense AS (\n",
        "  SELECT *,\n",
        "    ROW_NUMBER() OVER (PARTITION BY season ORDER BY YPG DESC) as RANK\n",
        "  FROM offensive_stats\n",
        ")\n",
        "SELECT *\n",
        "FROM ranked_offense\n",
        "ORDER BY season DESC, RANK\n"
      ]
    },
    {
      "name": "fourth_down_stats",
      "displayName": "Fourth Down Conversion Stats",
      "queryLines": [
        "WITH fourth_down_stats AS (\n",
        "  SELECT \n",
        "    s.season,\n",
        "    s.team_name,\n",
        "    t.primary_logo_url as team_logo,\n",
        "    t.conference_name,\n",
        "    s.games as G,\n",
        "    s.fourth_down_conversions as CONV,\n",
        "    s.fourth_down_attempts as ATT,\n",
        "    CASE \n",
        "      WHEN s.fourth_down_attempts > 0 \n",
        "      THEN ROUND((s.fourth_down_conversions::float / s.fourth_down_attempts::float) * 100, 1)\n",
        "      ELSE 0.0 \n",
        "    END as PCT\n",
        "  FROM cfdb_dev.silver_clean.season_stats s\n",
        "  JOIN cfdb_dev.silver_clean.teams t ON s.team_id = t.team_id\n",
        "  WHERE s.games > 0\n",
        "    AND s.fourth_down_attempts > 0\n",
        "),\n",
        "ranked_fourth_down AS (\n",
        "  SELECT *,\n",
        "    ROW_NUMBER() OVER (PARTITION BY season ORDER BY PCT DESC, CONV DESC) as RANK\n",
        "  FROM fourth_down_stats\n",
        ")\n",
        "SELECT *\n",
        "FROM ranked_fourth_down\n",
        "ORDER BY season DESC, RANK\n"
      ]
    }
  ],
